# Copy this file to .docker.env before starting Docker Compose.
# Values below are development-only examples. Replace the secrets locally.

# Published host ports
FRONTEND_PORT=5173
BACKEND_PORT=8000
MYSQL_EXPOSED_PORT=3307

# MySQL container and FastAPI database settings
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_DATABASE=optiacademic_db
MYSQL_USER=optiacademic
MYSQL_PASSWORD=replace_with_local_app_password

# FastAPI security and CORS settings
SECRET_KEY=replace_with_a_long_random_local_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# URL used by the browser-based Vite application
VITE_API_URL=http://127.0.0.1:8000/api/v1
