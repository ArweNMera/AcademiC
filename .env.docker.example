# APP
APP_NAME=OptiAcademic
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# API
API_V1_PREFIX=/api/v1

# DATABASE MYSQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=optiacademic_db

# JWT
SECRET_KEY=optiacademic_secret_key_docker
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://frontend:5173"]
